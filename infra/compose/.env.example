# Copie para .env e preencha. O .env NÃO é versionado.
#
# Gere cada segredo com:  openssl rand -base64 32

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Usuário do banco do CMS. Só enxerga o banco 'cms'.
CMS_DB_USER=directus
CMS_DB_PASSWORD=

# Usuário do banco do CathedrAll. Só enxerga o banco 'cathedrall'.
# Ainda não usado — a API não existe. Criado desde já para a separação nascer pronta.
APP_DB_USER=cathedrall
APP_DB_PASSWORD=

# ─── Directus ─────────────────────────────────────────────────────────────────
# KEY e SECRET não podem mudar depois que houver dado: SECRET assina os tokens de
# sessão e KEY participa da criptografia. Trocar invalida sessões e pode tornar
# dados ilegíveis. Gere uma vez, guarde bem.
DIRECTUS_KEY=
DIRECTUS_SECRET=

DIRECTUS_ADMIN_EMAIL=secretaria@ibscristo.com.br
DIRECTUS_ADMIN_PASSWORD=

# Local: http://localhost:8055
# Produção: https://cms.ibscristo.com.br
DIRECTUS_PUBLIC_URL=http://localhost:8055
