root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

# Espelha as exceções do .gitattributes. Se divergirem, o editor e o git ficam brigando
# pelo mesmo arquivo a cada save.
[*.{bat,cmd}]
end_of_line = crlf

[*.sln]
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
