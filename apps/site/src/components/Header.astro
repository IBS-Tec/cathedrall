---
// Navegação conforme docs/site-mapa-de-paginas.md.
// Blog ficou fora do v1 de propósito: seção vazia comunica abandono.
const items = [
  { label: "Quem somos", href: "/sobre" },
  { label: "Pequenos grupos", href: "/pequenos-grupos" },
  { label: "Missões", href: "/missoes" },
  { label: "Agenda", href: "/agenda" },
  { label: "Contato", href: "/contato" },
];

const current = Astro.url.pathname;
---

<header class="border-b border-neutral-200">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4">
    <a href="/" class="font-semibold">IBS Cristo Redentor</a>

    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.href ? "page" : undefined}
              class="text-neutral-600 underline-offset-4 hover:underline aria-[current=page]:font-medium aria-[current=page]:text-neutral-900"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
